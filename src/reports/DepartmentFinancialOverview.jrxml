<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DepartmentFinancialOverview" pageWidth="595" pageHeight="842" orientation="Landscape" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="76e4c009-e735-453a-be8c-12abb89a0ba2">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MySqlUniversityDB"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
            d.department_name,
            COUNT(DISTINCT s.student_id) AS total_students,
            COUNT(DISTINCT c.course_id) AS total_courses,
            COUNT(e.enrollment_id) AS total_enrollments,
            SUM(c.fee)* COUNT(e.enrollment_id) AS total_income
        FROM departments d
        LEFT JOIN students s ON d.department_id = s.department_id
        LEFT JOIN courses c ON d.department_id = c.department_id
        LEFT JOIN enrollments e ON d.department_id = e.department_id
        GROUP BY d.department_name
        ORDER BY total_income DESC]]>
	</queryString>
	<field name="department_name" class="java.lang.String"/>
	<field name="total_students" class="java.lang.Long"/>
	<field name="total_courses" class="java.lang.Long"/>
	<field name="total_enrollments" class="java.lang.Long"/>
	<field name="total_income" class="java.math.BigDecimal"/>
